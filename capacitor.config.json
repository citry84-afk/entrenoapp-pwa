{
  "appId": "com.lipastudios.entrenoapp",
  "appName": "EntrenoApp",
  "webDir": "www",
  "backgroundColor": "#080b12",
  "server": {
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "automatic"
  },
  "plugins": {
    "SystemBars": {
      "insetsHandling": "native",
      "style": "DARK",
      "hidden": false
    },
    "SplashScreen": {
      "launchShowDuration": 0,
      "launchAutoHide": true
    }
  }
}
