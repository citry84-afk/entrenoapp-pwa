# Configurar en Netlify > Site configuration > Environment variables.
# No copies valores reales dentro del repositorio.

PLUS_TOKEN_SECRET=crea_un_secreto_aleatorio_de_32_caracteres_o_mas
PLUS_ACCESS_CODES={"AMIGO-2026":{"months":12,"maxUses":5,"label":"Amigos"},"CREADOR-2026":{"months":3,"maxUses":100,"label":"Influencer"}}
PLUS_AI_DAILY_LIMIT=8
GEMINI_API_KEY=tu_clave_de_google_ai_studio
GEMINI_MODEL=gemini-2.5-flash-lite

# RevenueCat: la clave secreta va solo en Netlify Functions.
REVENUECAT_SECRET_API_KEY=tu_clave_secreta_de_revenuecat

# Protege el informe agregado /api/analytics/report.
ANALYTICS_ADMIN_TOKEN=crea_un_secreto_aleatorio_de_32_caracteres_o_mas

# Las claves públicas de RevenueCat para iOS/Android NO son secretas.
# En la app pueden definirse como window.ENTRENOAPP_REVENUECAT_IOS_KEY /
# window.ENTRENOAPP_REVENUECAT_ANDROID_KEY o guardarse temporalmente en localStorage
# para pruebas: ea_revenuecat_ios_key y ea_revenuecat_android_key.
